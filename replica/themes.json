{
  "_about": "Themes for work-management tools (issue trackers and Kanban boards), adapted from the replica-entrepreneur default. Used with: python3 .claude/skills/replica-entrepreneur/reviews.py replica/reviews.csv --themes replica/themes.json --out replica/feedback.md",
  "request_patterns": [
    "\\bi wish\\b",
    "\\bplease add\\b",
    "\\bwould be (nice|great|good|helpful)\\b",
    "\\bwould love\\b",
    "\\bno way to\\b",
    "\\bthere'?s no (way|option)\\b",
    "\\b(can'?t|cannot|unable to) (even )?(add|change|edit|set|choose|export|import|customi[sz]e|connect|undo|delete|turn off|see|filter|sort|assign)\\b",
    "\\b(missing|lacks|lacking)\\b",
    "\\bdoesn'?t (have|support|let|allow)\\b",
    "\\bif only\\b",
    "\\bfeature request\\b",
    "\\bwhy (can'?t|isn'?t|doesn'?t)\\b"
  ],
  "themes": [
    {"id": "complexity", "label": "Too complex: configuration, admin and bloat", "kind": "complaint",
     "patterns": ["\\bcomplex", "\\bcomplicated\\b", "\\bconvoluted\\b", "\\boverkill\\b", "\\bbloat", "\\boverwhelm", "\\blearning curve\\b", "\\bconfigur", "\\bworkflow scheme", "\\bcustom fields?\\b", "\\bjira admins?\\b", "\\btoo many (fields|options|features|clicks|settings|screens)\\b", "\\bover.?engineer"]},
    {"id": "performance", "label": "Slow and heavy", "kind": "complaint",
     "patterns": ["\\bslow(ness|ly|er)?\\b", "\\bsluggish\\b", "\\blag(gy|s)?\\b", "\\bloading\\b", "\\btakes forever\\b", "\\bheavy\\b", "\\bspinner"]},
    {"id": "process", "label": "Process overhead and micromanagement", "kind": "complaint",
     "patterns": ["\\bmicromanag", "\\bbureaucra", "\\bceremon", "\\boverhead\\b", "\\bred tape\\b", "\\bbusywork\\b", "\\bpaperwork\\b", "\\bprocess(es)? (heavy|overhead)\\b", "\\bheavyweight\\b", "\\bbox.?ticking\\b"]},
    {"id": "metrics", "label": "Metrics used to police teams", "kind": "complaint",
     "patterns": ["\\bvelocity\\b", "\\bstory points?\\b", "\\bburn.?down\\b", "\\bmetrics?\\b", "\\bkpis?\\b", "\\bperformance review", "\\bweaponi[sz]"]},
    {"id": "pricing", "label": "Price, per-seat costs and paywalls", "kind": "complaint",
     "patterns": ["\\bexpensive\\b", "\\boverpriced\\b", "\\bpric(e|es|ey|ing)\\b", "\\bper (seat|user)\\b", "\\blicen[cs](e|es|ing)\\b", "\\bcosts?\\b", "\\bpaywall", "\\bpremium\\b", "\\bupgrade to\\b", "\\bsubscription\\b"]},
    {"id": "outgrown", "label": "Simple boards run out of road", "kind": "complaint",
     "patterns": ["\\btoo (simple|basic|limited)\\b", "\\bdoesn'?t scale\\b", "\\bdon'?t scale\\b", "\\bat scale\\b", "\\boutgr[eo]w", "\\blimitations?\\b", "\\bpower.?ups?\\b", "\\bcan'?t handle\\b", "\\bonly (good|fine) for\\b"]},
    {"id": "visibility", "label": "No clear overview or reporting", "kind": "complaint",
     "patterns": ["\\breport(s|ing)?\\b", "\\bdashboards?\\b", "\\bvisibility\\b", "\\boverview\\b", "\\bstatus (update|report)s?\\b", "\\bbig picture\\b", "\\bspreadsheets?\\b", "\\bexcel\\b", "\\bmanagement (wants|asks)\\b"]},
    {"id": "sprawl", "label": "Too many tools, work split across them", "kind": "complaint",
     "patterns": ["\\bmultiple tools\\b", "\\bdifferent tools\\b", "\\banother tool\\b", "\\btool sprawl\\b", "\\bcontext.?switch", "\\bsilo", "\\bsingle source of truth\\b", "\\bin one place\\b", "\\bscattered\\b"]},
    {"id": "ux", "label": "Confusing or clunky to use", "kind": "complaint",
     "patterns": ["\\bconfus", "\\bhard to (use|find|navigate|understand|read)\\b", "\\bunintuitive\\b", "\\bnot intuitive\\b", "\\bclunky\\b", "\\bcluttered\\b", "\\bugly\\b", "\\bcan'?t find\\b", "\\bterrible (ui|ux|design)\\b", "\\bawful\\b", "\\bfrustrat"]},
    {"id": "bugs", "label": "Bugs and crashes", "kind": "complaint",
     "patterns": ["\\bcrash(es|ed|ing)?\\b", "\\bbugs?\\b", "\\bbuggy\\b", "\\bglitch", "\\bfreez(e|es|ing)\\b", "\\bbroken\\b", "\\b(doesn'?t|does not|stopped) work", "\\bnot working\\b", "\\berror\\b"]},
    {"id": "access", "label": "Login, access and permissions", "kind": "complaint",
     "patterns": ["\\blog ?in\\b", "\\bsign ?in\\b", "\\bpassword\\b", "\\blocked out\\b", "\\bsso\\b", "\\bpermissions?\\b", "\\baccess (to|rights|control)\\b", "\\bguests?\\b"]},
    {"id": "updates", "label": "Updates and redesigns made it worse", "kind": "complaint",
     "patterns": ["\\b(new|latest|recent) (update|version|design|ui)\\b", "\\bredesign", "\\bused to be\\b", "\\bbring back\\b", "\\bsince the update\\b"]},
    {"id": "offline-mobile", "label": "Mobile and offline", "kind": "request",
     "patterns": ["\\boffline\\b", "\\bipad\\b", "\\btablet\\b", "\\bmobile\\b", "\\bphone\\b", "\\bwidget"]},
    {"id": "integrations", "label": "Integrations, import and export", "kind": "request",
     "patterns": ["\\bintegrat", "\\bimport\\b", "\\bexport\\b", "\\bcsv\\b", "\\bapi\\b", "\\bcalendar\\b", "\\boutlook\\b", "\\bteams\\b"]},
    {"id": "customisation", "label": "Customisation and views", "kind": "request",
     "patterns": ["\\bcustomi[sz]", "\\bdark mode\\b", "\\btemplates?\\b", "\\bview(s)? (of|for)\\b", "\\bgantt\\b", "\\btimeline\\b", "\\bswim.?lanes?\\b", "\\bcolumns?\\b"]}
  ]
}
